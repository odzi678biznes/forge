# Backend only. Copy to .env.local and fill these locally; never prefix a secret with VITE_.
ANTHROPIC_API_KEY=
# Private Forge access code, minimum 24 characters; this is separate from the Anthropic key.
FORGE_TEACHER_ACCESS_CODE=
# Optional; otherwise uses the existing Forge teacher model.
# FORGE_TUTOR_MODEL=claude-sonnet-5

# Persistent local database. Requires Node 22.13+ (recommended Node 24 LTS).
FORGE_TUTOR_DB=.forge/tutor.sqlite

# Exact origins for a separately hosted frontend, Tauri and your phone on the LAN.
# Add your actual published origin or LAN IP; same-origin web access needs no extra entry.
FORGE_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:4173,http://127.0.0.1:4173,http://tauri.localhost,tauri://localhost

# Required on Vercel/serverless. Local development uses SQLite when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public endpoint only. Optional for same-origin web; configure for a static site or Tauri.
# VITE_TUTOR_API_URL=https://your-forge-backend.example/api/tutor
